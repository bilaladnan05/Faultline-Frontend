# Base URL the browser calls. Leave as /api to go through the Vite dev proxy, which
# keeps requests same-origin (the API enables no CORS). Set an absolute URL only when
# the API is served from an origin that does allow this app.
VITE_API_BASE_URL=/api

# Where the dev proxy forwards /api. Must match HOST/PORT of faultline-backend apps/api.
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Milliseconds before an API request is aborted.
VITE_API_TIMEOUT_MS=20000

# Poll interval for live views (runtime log stream, dashboard). 0 disables polling.
VITE_API_POLL_MS=15000
